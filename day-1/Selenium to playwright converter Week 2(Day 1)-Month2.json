      "parameters": {
        "jsCode": "const inputItems = $input.all();\n\nconst mergedItem = {\n  json: {},\n  binary: {},\n};\n\nlet fileIndex = 1;\ninputItems.forEach((item) => {\n  if (item.binary) {\n    Object.keys(item.binary).forEach((binaryKey) => {\n      const fileData = item.binary[binaryKey];\n      \n  \n      mergedItem.binary[`file${fileIndex}`] = fileData;\n      fileIndex++;\n    });\n  }\n});\n\nreturn [mergedItem];"
